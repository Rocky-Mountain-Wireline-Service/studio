{
  "name": "rmws-studio",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "version": "0.0.0",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "migrate": "sanity exec scripts/migrate-legacy.ts --with-user-token",
    "migrate:write": "MIGRATE_WRITE=1 sanity exec scripts/migrate-legacy.ts --with-user-token",
    "migrate:purge": "MIGRATE_WRITE=1 MIGRATE_PURGE=1 sanity exec scripts/migrate-legacy.ts --with-user-token",
    "design:content": "sanity exec scripts/apply-design-content.ts --with-user-token",
    "design:write": "DESIGN_WRITE=1 sanity exec scripts/apply-design-content.ts --with-user-token"
  },
  "dependencies": {
    "sanity": "^5.25.1",
    "@sanity/vision": "^5.25.1",
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "styled-components": "^6.1.15",
    "react-icons": "^5.4.0",
    "sanity-plugin-icon-picker": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "~5.7.0",
    "@types/react": "^19.0.0",
    "dotenv": "^16.4.0"
  }
}
